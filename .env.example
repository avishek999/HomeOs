# Generate a password hash with the instructions in README.md.
HOMEOS_PASSWORD_HASH=
# Generate a long random secret (32+ bytes) and keep it private.
HOMEOS_SESSION_SECRET=
# Keep true in production. Set to false only for temporary HTTP access on a
# private network; browsers will not store Secure cookies over plain HTTP.
HOMEOS_COOKIE_SECURE=true
# Optional: defaults to .homeos/homeos.sqlite in this project.
HOMEOS_DB_PATH=
# Required to enable uploads; must be a dedicated mounted volume outside /mnt/storage.
HOMEOS_DATA_ROOT=
# Optional, defaults to 10 GiB. Set according to the mounted volume capacity.
HOMEOS_STORAGE_QUOTA_BYTES=
# Daily managed-volume snapshot schedule (UTC).
HOMEOS_BACKUP_ENABLED=true
HOMEOS_BACKUP_HOUR_UTC=3
HOMEOS_BACKUP_RETENTION=7
HOMEOS_BACKUP_QUOTA_BYTES=53687091200
# Required by Docker Compose for the isolated helper; never share with GitHub.
HOMEOS_DOCKER_HELPER_SECRET=
# Host Docker socket group ID. Check with: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
# Optional. Fine-grained GitHub token with contents:read on only the repositories below.
HOMEOS_GITHUB_TOKEN=
# Explicit repository allow-list; each exposed host port is loopback-only.
HOMEOS_GITHUB_REPOSITORIES=[]
# Optional macOS development override. macOS dev uses mocks automatically.
HOMEOS_MOCK_SYSTEM=
